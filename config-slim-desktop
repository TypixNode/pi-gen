# Raspberry Pi OS with a desktop, trimmed to fit a 4GB eMMC (Compute Module 3).
#
#   sudo ./build.sh -c config-slim-desktop
#
# The stock desktop image is 6.5GB and the previous (Bookworm) one 6.2GB, so
# neither can be written to a 4GB module. This configuration replaces stage3 to
# stage5 with slim-desktop-stage, which trims the Lite rootfs and then installs
# the Raspberry Pi Desktop from the individual packages behind the rpd-* meta-
# packages instead of the metapackages themselves. The result is roughly a
# 3.0GB image that leaves about 1GB free once the root filesystem has grown to
# fill the module on first boot.
#
# Add `touch stage2/SKIP_IMAGES` if you do not also want the Lite image.

# Every setting below can be overridden from the environment, which is what the
# build-slim-desktop GitHub Actions workflow does.

IMG_NAME="${IMG_NAME:-raspios-slim-desktop}"

# The directory is deliberately not called stage-something: the default STAGE_LIST
# is the glob stage*, which would sort a stage-* directory ahead of stage0 and
# break every build that does not use this config.
STAGE_LIST="stage0 stage1 stage2 slim-desktop-stage"

# One kernel flavour and one Wi-Fi blob means the boot partition never gets
# close to the 512MB the stock images reserve.
BOOT_SIZE="${BOOT_SIZE:-$((256 * 1024 * 1024))}"

# The root filesystem grows to fill the storage on first boot, so the image only
# needs enough slack to hold the rootfs and let export-image run apt in it.
# ROOT_SIZE is measured with du --apparent-size, which undercounts a 4K-block
# ext4 by ~7% on a rootfs of this shape, and the filesystem's own metadata costs
# another few percent on top of that.
ROOT_MARGIN_PERCENT="${ROOT_MARGIN_PERCENT:-12}"
ROOT_MARGIN_FIXED="${ROOT_MARGIN_FIXED:-$((200 * 1024 * 1024))}"

# cloud-init and netplan cost ~60MB, and on Trixie they are what applies the
# hostname, user, password, SSH and Wi-Fi settings from Raspberry Pi Imager's
# advanced options: Trixie's raspberrypi-sys-mods no longer ships the init_config
# handler that read custom.toml, and the os-list entry this image is published
# with declares `init_format: cloudinit-rpi`. Turning this off means Imager's
# customisation silently does nothing.
ENABLE_CLOUD_INIT="${ENABLE_CLOUD_INIT:-1}"

# --- slim-desktop-stage knobs -------------------------------------------------
# These are read by the stage's scripts, which run as child processes, so they
# have to be exported.

# wayland (labwc, what the stock Trixie image boots into), x11 (openbox +
# lxpanel) or both. Installing only one saves ~85MB. x11 is the fallback if
# labwc misbehaves on the older VideoCore IV GPUs.
export SLIM_DESKTOP_SESSION="${SLIM_DESKTOP_SESSION:-wayland}"

# chromium, firefox or none. Either browser is by far the largest single item in
# the image: chromium is ~360MB installed (without chromium-l10n) and firefox
# ~280MB. `none` leaves ~360MB more free space.
export SLIM_BROWSER="${SLIM_BROWSER:-chromium}"

# Drop /usr/share/doc, /usr/share/man, /usr/share/info and the translation
# catalogues for every language except LOCALE_DEFAULT's.
export SLIM_STRIP_DOCS="${SLIM_STRIP_DOCS:-1}"

# Install Raspberry Pi Connect and wayvnc (~25MB). This is what the `rpi_connect`
# capability in the published os-list entry promises, so turning it off means
# dropping that capability from the JSON as well.
export SLIM_RPI_CONNECT="${SLIM_RPI_CONNECT:-1}"

# Keep apt's package indices compressed and skip the source cache.
export SLIM_APT_TRIM="${SLIM_APT_TRIM:-1}"

# Turn off the armhf multiarch that stage0 enables on arm64. Nothing in the image
# is armhf, and the architecture costs ~50MB of package indices and apt cache.
# Set to 0 if you need to install 32-bit packages.
export SLIM_DROP_FOREIGN_ARCH="${SLIM_DROP_FOREIGN_ARCH:-1}"

# Wi-Fi/Bluetooth firmware to keep. BCM43438/43455 covers every Compute Module
# and Raspberry Pi with onboard wireless; the other blobs are 220MB between
# them. Set to an empty string on a module without wireless.
export SLIM_KEEP_FIRMWARE="${SLIM_KEEP_FIRMWARE-firmware-brcm80211}"

# The kernel flavour to keep. rpi-v8 boots BCM2837 (Compute Module 3, Pi 3) and
# BCM2711 (Compute Module 4, Pi 4); rpi-2712 is Raspberry Pi 5 only. Dropping the
# flavour that cannot boot the target, its modules and its headers is ~90MB.
export SLIM_KEEP_KERNEL="${SLIM_KEEP_KERNEL:-rpi-v8}"

# Keep build-essential, gdb and the headers for the kernel above, so that
# out-of-tree kernel modules can still be built on the device. Set to 0 to
# reclaim the ~250MB they occupy.
export SLIM_KEEP_TOOLCHAIN="${SLIM_KEEP_TOOLCHAIN:-1}"

# Anything extra you want in the image, installed with --no-install-recommends
# together with the desktop. Installed sizes worth knowing about:
#   fonts-noto-cjk               89MB   Chinese/Japanese/Korean rendering
#   fonts-wqy-microhei            5MB   a much smaller Chinese font
#   vlc vlc-plugin-base          30MB   media player
#   firefox                     280MB   second browser
#   thonny python3-picamera2     30MB   the usual Python teaching tools
#   realvnc-vnc-server           39MB   remote desktop
#   rpi-imager                   39MB
export SLIM_EXTRA_PACKAGES="${SLIM_EXTRA_PACKAGES-}"

# The defaults for these live in slim-desktop-stage; override to reshape the
# package selection without editing the stage.
#export SLIM_PURGE_PACKAGES=""
#export SLIM_THEME_PACKAGES=""
#export SLIM_PREFS_PACKAGES=""
#export SLIM_APP_PACKAGES=""
