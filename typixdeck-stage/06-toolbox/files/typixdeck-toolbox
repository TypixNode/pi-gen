def detect_lang():
    for var in ("LC_ALL", "LC_MESSAGES", "LANG"):
        value = os.environ.get(var)
        if value:
            return "zh" if value.lower().startswith("zh") else "en"
    return "en"


T = STRINGS[detect_lang()]


def read_config():
    with open(CONFIG_PATH, encoding="utf-8", errors="replace") as f:
        return f.read()


def is_active(line, param):
    return line.strip() == f"dtparam={param}"


def is_commented(line, param):
    """A commented-out dtparam=<param>, ours or not."""
    s = line.strip()
    if not s.startswith("#"):
        return False
    code = s.lstrip("#").strip().split("#", 1)[0].strip()
    return code == f"dtparam={param}"


def current_antenna(text):
    """ant2 / ant1 from the last active line (last one wins in config.txt),
    or 'default' when no active ant* line exists."""
    mode = MODE_DEFAULT
    for line in text.splitlines():
        for param in ANT_PARAMS:
            if is_active(line, param):
                mode = param
    return mode


def strip_managed_block(lines):
    """Remove the toolbox-managed block, returning remaining lines."""
    out = []
    inside = False
    for line in lines:
        if line.strip() == MARK_BEGIN:
            inside = True
            continue
        if line.strip() == MARK_END:
            inside = False
            continue
        if not inside:
            out.append(line)
    return out


def disable_ant_line(line, params):
    """Comment out an active dtparam=<param> line, else return it unchanged."""
    for param in params:
        if is_active(line, param):
            return f"#dtparam={param}{DISABLED_SUFFIX}"
    return line


def build_new_config(text, mode):
    lines = strip_managed_block(text.splitlines())

    # Comment out every active ant* line that is not the wanted one,
    # in place, so a later switch can re-enable it where it was.
    disable = [p for p in ANT_PARAMS if p != mode]
    lines = [disable_ant_line(l, disable) for l in lines]

    if mode != MODE_DEFAULT:
        if not any(is_active(l, mode) for l in lines):
            # Semantic re-enable first: uncomment an existing commented-out
            # line in place (keeps position and section scope); only append
            # our own block when no such line exists anywhere.
            for i, line in enumerate(lines):
                if is_commented(line, mode):
                    lines[i] = f"dtparam={mode}"
                    break
            else:
                while lines and lines[-1].strip() == "":
                    lines.pop()
                lines += [
                    "",
                    MARK_BEGIN,
                    "[all]",
                    BLOCK_COMMENT[mode],
                    f"dtparam={mode}",
                    MARK_END,
                ]

    # Normalize trailing blank lines so repeated toggles are byte-stable.
    while lines and lines[-1].strip() == "":
        lines.pop()
    return "\n".join(lines) + "\n"


def write_config(new_text):
    """Write config.txt as root via pkexec (direct write when already root)."""
    if os.geteuid() == 0:
        with open(CONFIG_PATH, "w", encoding="utf-8") as f:
            f.write(new_text)
        return True
    with tempfile.NamedTemporaryFile(
        "w", encoding="utf-8", suffix=".txt", delete=False
    ) as tmp:
        tmp.write(new_text)
        tmp_path = tmp.name
    try:
        os.chmod(tmp_path, 0o644)
        res = subprocess.run(
            ["pkexec", "cp", "--", tmp_path, CONFIG_PATH], check=False
        )
        return res.returncode == 0
    finally:
        os.unlink(tmp_path)


class DiffDialog(Gtk.Dialog):
    """Colored unified diff of the pending config.txt change."""

    def __init__(self, parent, old, new):
        super().__init__(
            title=T["diff_title"],
            transient_for=parent,
            flags=0,
        )
        self.add_button(T["cancel"], Gtk.ResponseType.CANCEL)
        apply_btn = self.add_button(T["write"], Gtk.ResponseType.OK)
        apply_btn.get_style_context().add_class("suggested-action")
        self.set_default_size(560, 420)

        view = Gtk.TextView(
            editable=False, cursor_visible=False, monospace=True
        )
        view.set_wrap_mode(Gtk.WrapMode.NONE)
        buf = view.get_buffer()
        tag_add = buf.create_tag(
            "add", foreground="#00a000", weight=Pango.Weight.BOLD
        )
        tag_del = buf.create_tag(
            "del", foreground="#c00000", weight=Pango.Weight.BOLD
        )
        tag_hdr = buf.create_tag("hdr", foreground="#0060c0")

        diff = difflib.unified_diff(
            old.splitlines(keepends=True),
            new.splitlines(keepends=True),
            fromfile=CONFIG_PATH + T["diff_from"],
            tofile=CONFIG_PATH + T["diff_to"],
        )
        for line in diff:
            end = buf.get_end_iter()
            if line.startswith(("+++", "---", "@@")):
                buf.insert_with_tags(end, line, tag_hdr)
            elif line.startswith("+"):
                buf.insert_with_tags(end, line, tag_add)
            elif line.startswith("-"):
                buf.insert_with_tags(end, line, tag_del)
            else:
                buf.insert(end, line)

        scroll = Gtk.ScrolledWindow(margin=8)
        scroll.set_policy(
            Gtk.PolicyType.AUTOMATIC, Gtk.PolicyType.AUTOMATIC
        )
        scroll.add(view)
        self.get_content_area().pack_start(scroll, True, True, 0)
        self.show_all()


class ToolboxWindow(Gtk.Window):
    def __init__(self):
        super().__init__(title=T["title"])
        self.set_default_size(460, 300)
        self.set_position(Gtk.WindowPosition.CENTER)

        header = Gtk.HeaderBar(show_close_button=True)
        header.props.title = T["title"]
        self.set_titlebar(header)

        box = Gtk.Box(
            orientation=Gtk.Orientation.VERTICAL,
            spacing=12,
            margin=16,
        )
        self.add(box)

        frame = Gtk.Frame(label=T["antenna_frame"])
        box.pack_start(frame, False, False, 0)
        radio_box = Gtk.Box(
            orientation=Gtk.Orientation.VERTICAL, spacing=6, margin=12
        )
        frame.add(radio_box)

        self.radio_external = Gtk.RadioButton.new_with_label_from_widget(
            None, T["external"]
        )
        self.radio_internal = Gtk.RadioButton.new_with_label_from_widget(
            self.radio_external, T["internal"]
        )
        self.radio_default = Gtk.RadioButton.new_with_label_from_widget(
            self.radio_external, T["default"]
        )
        for radio in (
            self.radio_external, self.radio_internal, self.radio_default
        ):
            radio.get_child().set_line_wrap(True)
            radio_box.pack_start(radio, False, False, 0)

        self.status = Gtk.Label(xalign=0)
        self.status.set_line_wrap(True)
        box.pack_start(self.status, False, False, 0)

        apply_btn = Gtk.Button(label=T["apply"])
        apply_btn.get_style_context().add_class("suggested-action")
        apply_btn.connect("clicked", self.on_apply)
        box.pack_end(apply_btn, False, False, 0)

        self.load_state()

    def selected_mode(self):
        if self.radio_external.get_active():
            return MODE_EXTERNAL
        if self.radio_internal.get_active():
            return MODE_INTERNAL
        return MODE_DEFAULT

    def load_state(self):
        try:
            self._config = read_config()
        except OSError as e:
            self.status.set_text(
                T["read_error"].format(path=CONFIG_PATH, err=e)
            )
            self.set_sensitive(False)
            return
        current = current_antenna(self._config)
        radio = {
            MODE_EXTERNAL: self.radio_external,
            MODE_INTERNAL: self.radio_internal,
            MODE_DEFAULT: self.radio_default,
        }[current]
        radio.set_active(True)
        state = {
            MODE_EXTERNAL: T["state_external"],
            MODE_INTERNAL: T["state_internal"],
            MODE_DEFAULT: T["state_default"],
        }[current]
        self.status.set_markup(
            T["status"].format(state=state, path=CONFIG_PATH)
        )

    def info(self, text, secondary=None):
        dlg = Gtk.MessageDialog(
            transient_for=self,
            message_type=Gtk.MessageType.INFO,
            buttons=Gtk.ButtonsType.OK,
            text=text,
        )
        if secondary:
            dlg.format_secondary_text(secondary)
        dlg.run()
        dlg.destroy()

    def on_apply(self, _btn):
        old = read_config()
        new = build_new_config(old, self.selected_mode())
        if new == old:
            self.info(T["no_change"], T["no_change_detail"])
            return

        dlg = DiffDialog(self, old, new)
        response = dlg.run()
        dlg.destroy()
        if response != Gtk.ResponseType.OK:
            return

        if write_config(new):
            self._config = new
            self.load_state()
            self.ask_reboot()
        else:
            self.info(T["write_failed"], T["write_failed_detail"])

    def ask_reboot(self):
        dlg = Gtk.MessageDialog(
            transient_for=self,
            message_type=Gtk.MessageType.QUESTION,
            text=T["written"],
        )
        dlg.format_secondary_text(T["written_detail"])
        dlg.add_button(T["reboot_later"], Gtk.ResponseType.CANCEL)
        dlg.add_button(T["reboot_now"], Gtk.ResponseType.OK)
        response = dlg.run()
        dlg.destroy()
        if response == Gtk.ResponseType.OK:
            subprocess.run(["pkexec", "reboot"], check=False)


def main():
    win = ToolboxWindow()
    win.connect("destroy", Gtk.main_quit)
    win.show_all()
    Gtk.main()


if __name__ == "__main__":
    sys.exit(main())
