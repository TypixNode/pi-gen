def detect_lang():
    for var in ("LC_ALL", "LC_MESSAGES", "LANG"):
        value = os.environ.get(var)
        if value:
            return "zh" if value.lower().startswith("zh") else "en"
    return "en"


T = STRINGS[detect_lang()]


def read_config():
    with open(CONFIG_PATH, encoding="utf-8", errors="replace") as f:
        return f.read()


def is_active(line, param):
    return line.strip() == f"dtparam={param}"


def is_commented(line, param):
    """A commented-out dtparam=<param>, ours or not."""
    s = line.strip()
    if not s.startswith("#"):
        return False
    code = s.lstrip("#").strip().split("#", 1)[0].strip()
    return code == f"dtparam={param}"


def current_antenna(text):
    """ant2 / ant1 from the last active line (last one wins in config.txt),
    or 'default' when no active ant* line exists."""
    mode = MODE_DEFAULT
    for line in text.splitlines():
        for param in ANT_PARAMS:
            if is_active(line, param):
                mode = param
    return mode


def strip_managed_block(lines):
    """Remove the toolbox-managed block, returning remaining lines."""
    out = []
    inside = False
    for line in lines:
        if line.strip() == MARK_BEGIN:
            inside = True
            continue
        if line.strip() == MARK_END:
            inside = False
            continue
        if not inside:
            out.append(line)
    return out


def disable_ant_line(line, params):
    """Comment out an active dtparam=<param> line, else return it unchanged."""
    for param in params:
        if is_active(line, param):
            return f"#dtparam={param}{DISABLED_SUFFIX}"
    return line


def build_new_config(text, mode):
    lines = strip_managed_block(text.splitlines())

    # Comment out every active ant* line that is not the wanted one,
    # in place, so a later switch can re-enable it where it was.
    disable = [p for p in ANT_PARAMS if p != mode]
    lines = [disable_ant_line(l, disable) for l in lines]

    if mode != MODE_DEFAULT:
        if not any(is_active(l, mode) for l in lines):
            # Semantic re-enable first: uncomment an existing commented-out
            # line in place (keeps position and section scope); only append
            # our own block when no such line exists anywhere.
            for i, line in enumerate(lines):
                if is_commented(line, mode):
                    lines[i] = f"dtparam={mode}"
                    break
            else:
                while lines and lines[-1].strip() == "":
                    lines.pop()
                lines += [
                    "",
                    MARK_BEGIN,
                    "[all]",
                    BLOCK_COMMENT[mode],
                    f"dtparam={mode}",
                    MARK_END,
                ]

    # Normalize trailing blank lines so repeated toggles are byte-stable.
    while lines and lines[-1].strip() == "":
        lines.pop()
    return "\n".join(lines) + "\n"


def write_config(new_text):
    """Write config.txt as root via pkexec (direct write when already root)."""
    if os.geteuid() == 0:
        with open(CONFIG_PATH, "w", encoding="utf-8") as f:
            f.write(new_text)
        return True
    with tempfile.NamedTemporaryFile(
        "w", encoding="utf-8", suffix=".txt", delete=False
    ) as tmp:
        tmp.write(new_text)
        tmp_path = tmp.name
    try:
        os.chmod(tmp_path, 0o644)
        res = subprocess.run(
            ["pkexec", "cp", "--", tmp_path, CONFIG_PATH], check=False
        )
        return res.returncode == 0
    finally:
        os.unlink(tmp_path)


# ---------------------------------------------------------------------------
# Display scale via kanshi (same file + same SIGHUP reload Control Centre uses)
# ---------------------------------------------------------------------------
def kanshi_read():
    try:
        with open(KANSHI_PATH, encoding="utf-8") as f:
            return f.read()
    except OSError:
        return ""


def _output_line_tokens(line):
    """Tokens of an `output <name> ...` line inside a profile, else None."""
    tokens = line.strip().split()
    if len(tokens) >= 2 and tokens[0] == "output" and tokens[1] == PANEL_OUTPUT:
        return tokens
    return None


def kanshi_current_scale(text):
    for line in text.splitlines():
        tokens = _output_line_tokens(line)
        if tokens and "scale" in tokens:
            try:
                return float(tokens[tokens.index("scale") + 1])
            except (IndexError, ValueError):
                pass
    return None


def kanshi_with_scale(text, scale):
    """Return the kanshi config text with the panel's scale set to `scale`.
    Edits the existing output line in place; creates a profile if absent."""
    value = f"{float(scale):.6f}"
    lines = text.splitlines()
    for i, line in enumerate(lines):
        tokens = _output_line_tokens(line)
        if not tokens:
            continue
        indent = line[: len(line) - len(line.lstrip())]
        if "scale" in tokens:
            j = tokens.index("scale")
            if j + 1 < len(tokens):
                tokens[j + 1] = value
            else:
                tokens.append(value)
        else:
            k = tokens.index("enable") + 1 if "enable" in tokens else 2
            tokens[k:k] = ["scale", value]
        lines[i] = indent + " ".join(tokens)
        return "\n".join(lines) + "\n"
    # No profile for the panel yet: write one shaped like Control Centre's.
    return (
        "profile {\n"
        f"\t\toutput {PANEL_OUTPUT} enable scale {value} mode {PANEL_MODE} "
        "position 0,0 transform normal\n"
        "}\n"
    )


def kanshi_apply(scale, also_greeter):
    """Write ~/.config/kanshi/config, SIGHUP kanshi, optionally copy to the
    greeter via pkexec. Returns (ok, greeter_state)."""
    new = kanshi_with_scale(kanshi_read(), scale)
    os.makedirs(os.path.dirname(KANSHI_PATH), exist_ok=True)
    if os.path.exists(KANSHI_PATH):
        try:
            os.replace(KANSHI_PATH, KANSHI_PATH + ".bak")
        except OSError:
            pass
    with open(KANSHI_PATH, "w", encoding="utf-8") as f:
        f.write(new)
    # kanshi re-reads its config on SIGHUP (this is what Control Centre does)
    subprocess.run(["pkill", "--signal", "SIGHUP", "-x", "kanshi"], check=False)
    greeter = "skip"
    if also_greeter:
        res = subprocess.run(
            ["pkexec", "cp", "--", KANSHI_PATH, GREETER_KANSHI_PATH], check=False
        )
        greeter = "ok" if res.returncode == 0 else "fail"
    return True, greeter


def panel_scale():
    cur = kanshi_current_scale(kanshi_read())
    return cur if cur and cur > 0 else 1.0


def fit_window(win):
    """Keep the toolbox inside the 1024x768 panel at the current scale.
    At x1.5 the logical desktop is ~682x512; a 460x520 window overflows
    and the Display Apply button is unreachable."""
    scale = panel_scale()
    max_w = max(320, int(PANEL_PX[0] / scale) - 32)
    max_h = max(280, int(PANEL_PX[1] / scale) - 64)
    w = min(WIN_SIZE[0], max_w)
    h = min(WIN_SIZE[1], max_h)
    win.set_default_size(w, h)
    win.resize(w, h)
    geo = Gdk.Geometry()
    geo.min_width = 300
    geo.min_height = 260
    geo.max_width = max_w
    geo.max_height = max_h
    win.set_geometry_hints(
        None, geo, Gdk.WindowHints.MIN_SIZE | Gdk.WindowHints.MAX_SIZE
    )


def _tab_page(child):
    """Wrap a tab body so a too-tall page can still scroll to its button."""
    scroll = Gtk.ScrolledWindow()
    scroll.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
    scroll.add(child)
    return scroll


class DiffDialog(Gtk.Dialog):
    """Colored unified diff of the pending config.txt change."""

    def __init__(self, parent, old, new):
        super().__init__(
            title=T["diff_title"],
            transient_for=parent,
            flags=0,
        )
        self.add_button(T["cancel"], Gtk.ResponseType.CANCEL)
        apply_btn = self.add_button(T["write"], Gtk.ResponseType.OK)
        apply_btn.get_style_context().add_class("suggested-action")
        self.set_default_size(480, 300)

        view = Gtk.TextView(
            editable=False, cursor_visible=False, monospace=True
        )
        view.set_wrap_mode(Gtk.WrapMode.NONE)
        buf = view.get_buffer()
        tag_add = buf.create_tag(
            "add", foreground="#00a000", weight=Pango.Weight.BOLD
        )
        tag_del = buf.create_tag(
            "del", foreground="#c00000", weight=Pango.Weight.BOLD
        )
        tag_hdr = buf.create_tag("hdr", foreground="#0060c0")

        diff = difflib.unified_diff(
            old.splitlines(keepends=True),
            new.splitlines(keepends=True),
            fromfile=CONFIG_PATH + T["diff_from"],
            tofile=CONFIG_PATH + T["diff_to"],
        )
        for line in diff:
            end = buf.get_end_iter()
            if line.startswith(("+++", "---", "@@")):
                buf.insert_with_tags(end, line, tag_hdr)
            elif line.startswith("+"):
                buf.insert_with_tags(end, line, tag_add)
            elif line.startswith("-"):
                buf.insert_with_tags(end, line, tag_del)
            else:
                buf.insert(end, line)

        scroll = Gtk.ScrolledWindow(margin=8)
        scroll.set_policy(
            Gtk.PolicyType.AUTOMATIC, Gtk.PolicyType.AUTOMATIC
        )
        scroll.add(view)
        self.get_content_area().pack_start(scroll, True, True, 0)
        self.show_all()


class ToolboxWindow(Gtk.Window):
    def __init__(self):
        super().__init__(title=T["title"])
        self.set_position(Gtk.WindowPosition.CENTER)
        fit_window(self)

        header = Gtk.HeaderBar(show_close_button=True)
        header.props.title = T["title"]
        self.set_titlebar(header)

        nb = Gtk.Notebook()
        nb.set_scrollable(True)
        nb.set_show_border(False)
        self.add(nb)

        # ---- tab: antenna ----
        abox = Gtk.Box(
            orientation=Gtk.Orientation.VERTICAL, spacing=8, margin=10
        )
        self.radio_external = Gtk.RadioButton.new_with_label_from_widget(
            None, T["external"]
        )
        self.radio_internal = Gtk.RadioButton.new_with_label_from_widget(
            self.radio_external, T["internal"]
        )
        self.radio_default = Gtk.RadioButton.new_with_label_from_widget(
            self.radio_external, T["default"]
        )
        for radio in (
            self.radio_external, self.radio_internal, self.radio_default
        ):
            radio.get_child().set_line_wrap(True)
            abox.pack_start(radio, False, False, 0)

        self.status = Gtk.Label(xalign=0)
        self.status.set_line_wrap(True)
        abox.pack_start(self.status, False, False, 0)

        apply_btn = Gtk.Button(label=T["apply"])
        apply_btn.get_style_context().add_class("suggested-action")
        apply_btn.connect("clicked", self.on_apply)
        abox.pack_start(apply_btn, False, False, 0)
        nb.append_page(_tab_page(abox), Gtk.Label(label=T["tab_antenna"]))

        # ---- tab: display scale ----
        sbox = Gtk.Box(
            orientation=Gtk.Orientation.VERTICAL, spacing=8, margin=10
        )
        row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=16)
        sbox.pack_start(row, False, False, 0)
        self.scale_radios = {}
        first = None
        for sc in SCALES:
            r = Gtk.RadioButton.new_with_label_from_widget(first, f"x{sc}")
            first = first or r
            self.scale_radios[sc] = r
            row.pack_start(r, False, False, 0)
        hint = Gtk.Label(xalign=0, label=T["scale_hint"])
        hint.set_line_wrap(True)
        hint.get_style_context().add_class("dim-label")
        sbox.pack_start(hint, False, False, 0)
        self.greeter_check = Gtk.CheckButton(label=T["scale_greeter"])
        self.greeter_check.set_active(True)
        sbox.pack_start(self.greeter_check, False, False, 0)
        self.scale_status = Gtk.Label(xalign=0)
        self.scale_status.set_line_wrap(True)
        sbox.pack_start(self.scale_status, False, False, 0)
        sapply = Gtk.Button(label=T["scale_apply"])
        sapply.get_style_context().add_class("suggested-action")
        sapply.connect("clicked", self.on_apply_scale)
        sbox.pack_start(sapply, False, False, 0)
        nb.append_page(_tab_page(sbox), Gtk.Label(label=T["tab_scale"]))

        self.load_state()
        self.load_scale_state()
        # 1.5x 时默认停在显示页，避免再被裁掉的按钮困住
        if panel_scale() >= 1.5:
            nb.set_current_page(1)

    def load_scale_state(self):
        cur = kanshi_current_scale(kanshi_read())
        label = "1.0"
        if cur is not None:
            for sc in SCALES:
                if abs(float(sc) - cur) < 1e-3:
                    self.scale_radios[sc].set_active(True)
                    label = sc
                    break
            else:
                label = f"{cur:g}"
        self.scale_status.set_markup(
            T["scale_status"].format(scale=label, path=KANSHI_PATH)
        )

    def on_apply_scale(self, _btn):
        scale = next(sc for sc, r in self.scale_radios.items() if r.get_active())
        try:
            _ok, greeter = kanshi_apply(scale, self.greeter_check.get_active())
        except OSError as e:
            self.info(T["scale_fail"].format(path=KANSHI_PATH, err=e))
            return
        self.load_scale_state()
        fit_window(self)
        self.info(
            T["scale_applied"].format(scale=scale),
            T["scale_applied_detail"].format(greeter=T["greeter_" + greeter]),
        )

    def selected_mode(self):
        if self.radio_external.get_active():
            return MODE_EXTERNAL
        if self.radio_internal.get_active():
            return MODE_INTERNAL
        return MODE_DEFAULT

    def load_state(self):
        try:
            self._config = read_config()
        except OSError as e:
            self.status.set_text(
                T["read_error"].format(path=CONFIG_PATH, err=e)
            )
            self.set_sensitive(False)
            return
        current = current_antenna(self._config)
        radio = {
            MODE_EXTERNAL: self.radio_external,
            MODE_INTERNAL: self.radio_internal,
            MODE_DEFAULT: self.radio_default,
        }[current]
        radio.set_active(True)
        state = {
            MODE_EXTERNAL: T["state_external"],
            MODE_INTERNAL: T["state_internal"],
            MODE_DEFAULT: T["state_default"],
        }[current]
        self.status.set_markup(
            T["status"].format(state=state, path=CONFIG_PATH)
        )

    def info(self, text, secondary=None):
        dlg = Gtk.MessageDialog(
            transient_for=self,
            message_type=Gtk.MessageType.INFO,
            buttons=Gtk.ButtonsType.OK,
            text=text,
        )
        if secondary:
            dlg.format_secondary_text(secondary)
        dlg.run()
        dlg.destroy()

    def on_apply(self, _btn):
        old = read_config()
        new = build_new_config(old, self.selected_mode())
        if new == old:
            self.info(T["no_change"], T["no_change_detail"])
            return

        dlg = DiffDialog(self, old, new)
        response = dlg.run()
        dlg.destroy()
        if response != Gtk.ResponseType.OK:
            return

        if write_config(new):
            self._config = new
            self.load_state()
            self.ask_reboot()
        else:
            self.info(T["write_failed"], T["write_failed_detail"])

    def ask_reboot(self):
        dlg = Gtk.MessageDialog(
            transient_for=self,
            message_type=Gtk.MessageType.QUESTION,
            text=T["written"],
        )
        dlg.format_secondary_text(T["written_detail"])
        dlg.add_button(T["reboot_later"], Gtk.ResponseType.CANCEL)
        dlg.add_button(T["reboot_now"], Gtk.ResponseType.OK)
        response = dlg.run()
        dlg.destroy()
        if response == Gtk.ResponseType.OK:
            subprocess.run(["pkexec", "reboot"], check=False)


def main():
    win = ToolboxWindow()
    win.connect("destroy", Gtk.main_quit)
    win.show_all()
    Gtk.main()


if __name__ == "__main__":
    sys.exit(main())
