def detect_lang():
    for var in ("LC_ALL", "LC_MESSAGES", "LANG"):
        value = os.environ.get(var)
        if value:
            return "zh" if value.lower().startswith("zh") else "en"
    return "en"


T = STRINGS[detect_lang()]


def read_config():
    with open(CONFIG_PATH, encoding="utf-8", errors="replace") as f:
        return f.read()


def is_active(line, param):
    return line.strip() == f"dtparam={param}"


def is_commented(line, param):
    """A commented-out dtparam=<param>, ours or not."""
    s = line.strip()
    if not s.startswith("#"):
        return False
    code = s.lstrip("#").strip().split("#", 1)[0].strip()
    return code == f"dtparam={param}"


def current_antenna(text):
    """ant2 / ant1 from the last active line (last one wins in config.txt),
    or 'default' when no active ant* line exists."""
    mode = MODE_DEFAULT
    for line in text.splitlines():
        for param in ANT_PARAMS:
            if is_active(line, param):
                mode = param
    return mode


def strip_managed_block(lines):
    """Remove the toolbox-managed block, returning remaining lines."""
    out = []
    inside = False
    for line in lines:
        if line.strip() == MARK_BEGIN:
            inside = True
            continue
        if line.strip() == MARK_END:
            inside = False
            continue
        if not inside:
            out.append(line)
    return out


def disable_ant_line(line, params):
    """Comment out an active dtparam=<param> line, else return it unchanged."""
    for param in params:
        if is_active(line, param):
            return f"#dtparam={param}{DISABLED_SUFFIX}"
    return line


def build_new_config(text, mode):
    lines = strip_managed_block(text.splitlines())

    # Comment out every active ant* line that is not the wanted one,
    # in place, so a later switch can re-enable it where it was.
    disable = [p for p in ANT_PARAMS if p != mode]
    lines = [disable_ant_line(l, disable) for l in lines]

    if mode != MODE_DEFAULT:
        if not any(is_active(l, mode) for l in lines):
            # Semantic re-enable first: uncomment an existing commented-out
            # line in place (keeps position and section scope); only append
            # our own block when no such line exists anywhere.
            for i, line in enumerate(lines):
                if is_commented(line, mode):
                    lines[i] = f"dtparam={mode}"
                    break
            else:
                while lines and lines[-1].strip() == "":
                    lines.pop()
                lines += [
                    "",
                    MARK_BEGIN,
                    "[all]",
                    BLOCK_COMMENT[mode],
                    f"dtparam={mode}",
                    MARK_END,
                ]

    # Normalize trailing blank lines so repeated toggles are byte-stable.
    while lines and lines[-1].strip() == "":
        lines.pop()
    return "\n".join(lines) + "\n"


def write_config(new_text):
    """Write config.txt as root via pkexec (direct write when already root)."""
    if os.geteuid() == 0:
        with open(CONFIG_PATH, "w", encoding="utf-8") as f:
            f.write(new_text)
        return True
    with tempfile.NamedTemporaryFile(
        "w", encoding="utf-8", suffix=".txt", delete=False
    ) as tmp:
        tmp.write(new_text)
        tmp_path = tmp.name
    try:
        os.chmod(tmp_path, 0o644)
        res = subprocess.run(
            ["pkexec", "cp", "--", tmp_path, CONFIG_PATH], check=False
        )
        return res.returncode == 0
    finally:
        os.unlink(tmp_path)


# ---------------------------------------------------------------------------
# Display scale via kanshi (same file + same SIGHUP reload Control Centre uses)
# ---------------------------------------------------------------------------
def kanshi_read():
    try:
        with open(KANSHI_PATH, encoding="utf-8") as f:
            return f.read()
    except OSError:
        return ""


def _output_line_tokens(line):
    """Tokens of an `output <name> ...` line inside a profile, else None."""
    tokens = line.strip().split()
    if len(tokens) >= 2 and tokens[0] == "output" and tokens[1] == PANEL_OUTPUT:
        return tokens
    return None


def kanshi_current_scale(text):
    for line in text.splitlines():
        tokens = _output_line_tokens(line)
        if tokens and "scale" in tokens:
            try:
                return float(tokens[tokens.index("scale") + 1])
            except (IndexError, ValueError):
                pass
    return None


def kanshi_with_scale(text, scale):
    """Return the kanshi config text with the panel's scale set to `scale`.
    Edits the existing output line in place; creates a profile if absent."""
    value = f"{float(scale):.6f}"
    lines = text.splitlines()
    for i, line in enumerate(lines):
        tokens = _output_line_tokens(line)
        if not tokens:
            continue
        indent = line[: len(line) - len(line.lstrip())]
        if "scale" in tokens:
            j = tokens.index("scale")
            if j + 1 < len(tokens):
                tokens[j + 1] = value
            else:
                tokens.append(value)
        else:
            k = tokens.index("enable") + 1 if "enable" in tokens else 2
            tokens[k:k] = ["scale", value]
        lines[i] = indent + " ".join(tokens)
        return "\n".join(lines) + "\n"
    # No profile for the panel yet: write one shaped like Control Centre's.
    return (
        "profile {\n"
        f"\t\toutput {PANEL_OUTPUT} enable scale {value} mode {PANEL_MODE} "
        "position 0,0 transform normal\n"
        "}\n"
    )


def kanshi_apply(scale, also_greeter):
    """Write ~/.config/kanshi/config, SIGHUP kanshi, optionally copy to the
    greeter via pkexec. Returns (ok, greeter_state)."""
    new = kanshi_with_scale(kanshi_read(), scale)
    os.makedirs(os.path.dirname(KANSHI_PATH), exist_ok=True)
    if os.path.exists(KANSHI_PATH):
        try:
            os.replace(KANSHI_PATH, KANSHI_PATH + ".bak")
        except OSError:
            pass
    with open(KANSHI_PATH, "w", encoding="utf-8") as f:
        f.write(new)
    # kanshi re-reads its config on SIGHUP (this is what Control Centre does)
    subprocess.run(["pkill", "--signal", "SIGHUP", "-x", "kanshi"], check=False)
    greeter = "skip"
    if also_greeter:
        res = subprocess.run(
            ["pkexec", "cp", "--", KANSHI_PATH, GREETER_KANSHI_PATH], check=False
        )
        greeter = "ok" if res.returncode == 0 else "fail"
    return True, greeter


# ---------------------------------------------------------------------------
# APT sources: official <-> domestic mirror, with one-time backups
# ---------------------------------------------------------------------------
APT_SOURCES = (
    "/etc/apt/sources.list.d/debian.sources",
    "/etc/apt/sources.list.d/raspi.sources",
)
APT_BACKUP_SUFFIX = ".bak-official"
# (official host/path, mirror host/path). Official archives are served
# over http, the mirror over https. Compared as whole strings so
# "debian/" can never match "debian-security/".
APT_MIRRORS = (
    ("deb.debian.org/debian-security/",
     "mirrors.tuna.tsinghua.edu.cn/debian-security/"),
    ("deb.debian.org/debian/", "mirrors.tuna.tsinghua.edu.cn/debian/"),
    ("archive.raspberrypi.com/debian/",
     "mirrors.tuna.tsinghua.edu.cn/raspberrypi/"),
)
APT_OFFICIAL, APT_DOMESTIC, APT_CUSTOM = "official", "domestic", "custom"


def _bare_uri(uri):
    """Scheme stripped, exactly one trailing slash."""
    for scheme in ("https://", "http://"):
        if uri.startswith(scheme):
            uri = uri[len(scheme):]
            break
    return uri.rstrip("/") + "/"


def _map_uri(uri, to_domestic):
    bare = _bare_uri(uri)
    for official, mirror in APT_MIRRORS:
        src, dst = (official, mirror) if to_domestic else (mirror, official)
        if bare == src:
            return ("https://" if to_domestic else "http://") + dst
    return uri


def apt_transform(text, to_domestic):
    """Rewrite every `URIs:` line of a deb822 .sources file."""
    out = []
    for line in text.splitlines():
        if line.startswith("URIs:"):
            uris = line[len("URIs:"):].split()
            line = "URIs: " + " ".join(_map_uri(u, to_domestic) for u in uris)
        out.append(line)
    return "\n".join(out) + "\n"


def apt_read(path):
    try:
        with open(path, encoding="utf-8") as f:
            return f.read()
    except OSError:
        return ""


def apt_uris(text):
    uris = []
    for line in text.splitlines():
        if line.startswith("URIs:"):
            uris += [_bare_uri(u) for u in line[len("URIs:"):].split()]
    return uris


def apt_state(texts):
    uris = [u for t in texts for u in apt_uris(t)]
    if not uris:
        return APT_CUSTOM
    if all(u in {m for _, m in APT_MIRRORS} for u in uris):
        return APT_DOMESTIC
    if all(u in {o for o, _ in APT_MIRRORS} for u in uris):
        return APT_OFFICIAL
    return APT_CUSTOM


def apt_backups_present():
    return any(os.path.exists(p + APT_BACKUP_SUFFIX) for p in APT_SOURCES)


def apt_plan(mode):
    """[(path, old, new)] for switching to `mode`. Going back to official
    prefers the .bak-official copy taken when the mirror was first enabled
    and falls back to the reverse URI mapping."""
    plan = []
    for path in APT_SOURCES:
        old = apt_read(path)
        if not old:
            continue
        new = None
        if mode == APT_OFFICIAL:
            new = apt_read(path + APT_BACKUP_SUFFIX) or None
        if new is None:
            new = apt_transform(old, mode == APT_DOMESTIC)
        plan.append((path, old, new))
    return plan


def apt_apply(plan, mode, run_update):
    """Write the planned files as root in ONE pkexec call (backing the
    originals up first when enabling the mirror) and optionally run
    apt-get update. Returns (rc, update_log_tail): rc 0 = all good,
    3 = files written but apt update failed, anything else = not written."""
    tmpdir = tempfile.mkdtemp(prefix="typixdeck-apt-")
    try:
        log = os.path.join(tmpdir, "update.log")
        script = ["set -e"]
        for i, (path, _old, new) in enumerate(plan):
            tmp = os.path.join(tmpdir, f"src{i}")
            with open(tmp, "w", encoding="utf-8") as f:
                f.write(new)
            os.chmod(tmp, 0o644)
            if mode == APT_DOMESTIC:
                bak = path + APT_BACKUP_SUFFIX
                script.append(f"[ -e '{bak}' ] || cp -p -- '{path}' '{bak}'")
            script.append(f"cp -- '{tmp}' '{path}' && chmod 644 '{path}'")
        if run_update:
            script.append(f"apt-get update > '{log}' 2>&1 || exit 3")
        script_path = os.path.join(tmpdir, "apply.sh")
        with open(script_path, "w", encoding="utf-8") as f:
            f.write("\n".join(script) + "\n")
        os.chmod(tmpdir, 0o755)   # root reads it; pkexec keeps our uid's dir
        cmd = ["sh", script_path]
        if os.geteuid() != 0:
            cmd = ["pkexec"] + cmd
        rc = subprocess.run(cmd, check=False).returncode
        tail = ""
        if run_update and os.path.exists(log):
            with open(log, encoding="utf-8", errors="replace") as f:
                tail = "".join(f.readlines()[-6:])
        return rc, tail
    finally:
        shutil.rmtree(tmpdir, ignore_errors=True)


def panel_scale():
    cur = kanshi_current_scale(kanshi_read())
    return cur if cur and cur > 0 else 1.0


def fit_window(win):
    """Keep the toolbox inside the 1024x768 panel at the current scale.
    At x1.5 the logical desktop is ~682x512; a 460x520 window overflows
    and the Display Apply button is unreachable."""
    scale = panel_scale()
    max_w = max(320, int(PANEL_PX[0] / scale) - 32)
    max_h = max(280, int(PANEL_PX[1] / scale) - 64)
    w = min(WIN_SIZE[0], max_w)
    h = min(WIN_SIZE[1], max_h)
    win.set_default_size(w, h)
    win.resize(w, h)
    geo = Gdk.Geometry()
    geo.min_width = 300
    geo.min_height = 260
    geo.max_width = max_w
    geo.max_height = max_h
    win.set_geometry_hints(
        None, geo, Gdk.WindowHints.MIN_SIZE | Gdk.WindowHints.MAX_SIZE
    )


def _tab_page(child):
    """Wrap a tab body so a too-tall page can still scroll to its button."""
    scroll = Gtk.ScrolledWindow()
    scroll.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
    scroll.add(child)
    return scroll


class DiffDialog(Gtk.Dialog):
    """Colored unified diff of the pending config.txt change."""

    def __init__(self, parent, old, new, title=None, path=CONFIG_PATH):
        super().__init__(
            title=title or T["diff_title"],
            transient_for=parent,
            flags=0,
        )
        self.add_button(T["cancel"], Gtk.ResponseType.CANCEL)
        apply_btn = self.add_button(T["write"], Gtk.ResponseType.OK)
        apply_btn.get_style_context().add_class("suggested-action")
        self.set_default_size(480, 300)

        view = Gtk.TextView(
            editable=False, cursor_visible=False, monospace=True
        )
        view.set_wrap_mode(Gtk.WrapMode.NONE)
        buf = view.get_buffer()
        tag_add = buf.create_tag(
            "add", foreground="#00a000", weight=Pango.Weight.BOLD
        )
        tag_del = buf.create_tag(
            "del", foreground="#c00000", weight=Pango.Weight.BOLD
        )
        tag_hdr = buf.create_tag("hdr", foreground="#0060c0")

        diff = difflib.unified_diff(
            old.splitlines(keepends=True),
            new.splitlines(keepends=True),
            fromfile=path + T["diff_from"],
            tofile=path + T["diff_to"],
        )
        for line in diff:
            end = buf.get_end_iter()
            if line.startswith(("+++", "---", "@@")):
                buf.insert_with_tags(end, line, tag_hdr)
            elif line.startswith("+"):
                buf.insert_with_tags(end, line, tag_add)
            elif line.startswith("-"):
                buf.insert_with_tags(end, line, tag_del)
            else:
                buf.insert(end, line)

        scroll = Gtk.ScrolledWindow(margin=8)
        scroll.set_policy(
            Gtk.PolicyType.AUTOMATIC, Gtk.PolicyType.AUTOMATIC
        )
        scroll.add(view)
        self.get_content_area().pack_start(scroll, True, True, 0)
        self.show_all()


class ToolboxWindow(Gtk.Window):
    def __init__(self):
        super().__init__(title=T["title"])
        self.set_position(Gtk.WindowPosition.CENTER)
        fit_window(self)

        header = Gtk.HeaderBar(show_close_button=True)
        header.props.title = T["title"]
        self.set_titlebar(header)

        nb = Gtk.Notebook()
        nb.set_scrollable(True)
        nb.set_show_border(False)
        self.add(nb)

        # ---- tab: antenna ----
        abox = Gtk.Box(
            orientation=Gtk.Orientation.VERTICAL, spacing=8, margin=10
        )
        self.radio_external = Gtk.RadioButton.new_with_label_from_widget(
            None, T["external"]
        )
        self.radio_internal = Gtk.RadioButton.new_with_label_from_widget(
            self.radio_external, T["internal"]
        )
        self.radio_default = Gtk.RadioButton.new_with_label_from_widget(
            self.radio_external, T["default"]
        )
        for radio in (
            self.radio_external, self.radio_internal, self.radio_default
        ):
            radio.get_child().set_line_wrap(True)
            abox.pack_start(radio, False, False, 0)

        self.status = Gtk.Label(xalign=0)
        self.status.set_line_wrap(True)
        abox.pack_start(self.status, False, False, 0)

        apply_btn = Gtk.Button(label=T["apply"])
        apply_btn.get_style_context().add_class("suggested-action")
        apply_btn.connect("clicked", self.on_apply)
        abox.pack_start(apply_btn, False, False, 0)
        nb.append_page(_tab_page(abox), Gtk.Label(label=T["tab_antenna"]))

        # ---- tab: display scale ----
        sbox = Gtk.Box(
            orientation=Gtk.Orientation.VERTICAL, spacing=8, margin=10
        )
        row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=16)
        sbox.pack_start(row, False, False, 0)
        self.scale_radios = {}
        first = None
        for sc in SCALES:
            r = Gtk.RadioButton.new_with_label_from_widget(first, f"x{sc}")
            first = first or r
            self.scale_radios[sc] = r
            row.pack_start(r, False, False, 0)
        hint = Gtk.Label(xalign=0, label=T["scale_hint"])
        hint.set_line_wrap(True)
        hint.get_style_context().add_class("dim-label")
        sbox.pack_start(hint, False, False, 0)
        self.greeter_check = Gtk.CheckButton(label=T["scale_greeter"])
        self.greeter_check.set_active(True)
        sbox.pack_start(self.greeter_check, False, False, 0)
        self.scale_status = Gtk.Label(xalign=0)
        self.scale_status.set_line_wrap(True)
        sbox.pack_start(self.scale_status, False, False, 0)
        sapply = Gtk.Button(label=T["scale_apply"])
        sapply.get_style_context().add_class("suggested-action")
        sapply.connect("clicked", self.on_apply_scale)
        sbox.pack_start(sapply, False, False, 0)
        nb.append_page(_tab_page(sbox), Gtk.Label(label=T["tab_scale"]))

        # ---- tab: APT sources ----
        pbox = Gtk.Box(
            orientation=Gtk.Orientation.VERTICAL, spacing=8, margin=10
        )
        self.apt_radio_domestic = Gtk.RadioButton.new_with_label_from_widget(
            None, T["apt_domestic"]
        )
        self.apt_radio_official = Gtk.RadioButton.new_with_label_from_widget(
            self.apt_radio_domestic, T["apt_official"]
        )
        for radio in (self.apt_radio_domestic, self.apt_radio_official):
            radio.get_child().set_line_wrap(True)
            pbox.pack_start(radio, False, False, 0)
        ahint = Gtk.Label(xalign=0, label=T["apt_hint"])
        ahint.set_line_wrap(True)
        ahint.get_style_context().add_class("dim-label")
        pbox.pack_start(ahint, False, False, 0)
        self.apt_update_check = Gtk.CheckButton(label=T["apt_update"])
        self.apt_update_check.set_active(True)
        pbox.pack_start(self.apt_update_check, False, False, 0)
        self.apt_status = Gtk.Label(xalign=0)
        self.apt_status.set_line_wrap(True)
        pbox.pack_start(self.apt_status, False, False, 0)
        papply = Gtk.Button(label=T["apt_apply"])
        papply.get_style_context().add_class("suggested-action")
        papply.connect("clicked", self.on_apply_apt)
        pbox.pack_start(papply, False, False, 0)
        nb.append_page(_tab_page(pbox), Gtk.Label(label=T["tab_apt"]))

        self.load_state()
        self.load_scale_state()
        self.load_apt_state()
        # 1.5x 时默认停在显示页，避免再被裁掉的按钮困住
        if panel_scale() >= 1.5:
            nb.set_current_page(1)

    def load_scale_state(self):
        cur = kanshi_current_scale(kanshi_read())
        label = "1.0"
        if cur is not None:
            for sc in SCALES:
                if abs(float(sc) - cur) < 1e-3:
                    self.scale_radios[sc].set_active(True)
                    label = sc
                    break
            else:
                label = f"{cur:g}"
        self.scale_status.set_markup(
            T["scale_status"].format(scale=label, path=KANSHI_PATH)
        )

    def on_apply_scale(self, _btn):
        scale = next(sc for sc, r in self.scale_radios.items() if r.get_active())
        try:
            _ok, greeter = kanshi_apply(scale, self.greeter_check.get_active())
        except OSError as e:
            self.info(T["scale_fail"].format(path=KANSHI_PATH, err=e))
            return
        self.load_scale_state()
        fit_window(self)
        self.info(
            T["scale_applied"].format(scale=scale),
            T["scale_applied_detail"].format(greeter=T["greeter_" + greeter]),
        )

    # ---- APT sources ----
    def load_apt_state(self):
        state = apt_state([apt_read(p) for p in APT_SOURCES])
        if state == APT_DOMESTIC:
            self.apt_radio_domestic.set_active(True)
        elif state == APT_OFFICIAL:
            self.apt_radio_official.set_active(True)
        backup = T["apt_backup_yes" if apt_backups_present() else "apt_backup_no"]
        self.apt_status.set_markup(
            T["apt_status"].format(state=T["apt_state_" + state], backup=backup)
        )

    def on_apply_apt(self, _btn):
        mode = (
            APT_DOMESTIC if self.apt_radio_domestic.get_active() else APT_OFFICIAL
        )
        plan = [p for p in apt_plan(mode) if p[1] != p[2]]
        if not plan:
            self.info(T["no_change"], T["apt_state_" + apt_state(
                [apt_read(p) for p in APT_SOURCES])])
            return
        # One combined diff: each file introduced by a "## path" header.
        old = "".join(f"## {p}\n{o}\n" for p, o, _n in plan)
        new = "".join(f"## {p}\n{n}\n" for p, _o, n in plan)
        dlg = DiffDialog(
            self, old, new, title=T["apt_diff_title"],
            path=os.path.dirname(APT_SOURCES[0]),
        )
        response = dlg.run()
        dlg.destroy()
        if response != Gtk.ResponseType.OK:
            return
        run_update = self.apt_update_check.get_active()
        self.set_sensitive(False)
        self.apt_status.set_text(T["apt_working"])
        threading.Thread(
            target=self._apt_worker, args=(plan, mode, run_update), daemon=True
        ).start()

    def _apt_worker(self, plan, mode, run_update):
        try:
            rc, tail = apt_apply(plan, mode, run_update)
        except OSError as e:
            rc, tail = -1, str(e)
        GLib.idle_add(self._apt_done, rc, tail, run_update)

    def _apt_done(self, rc, tail, run_update):
        self.set_sensitive(True)
        self.load_apt_state()
        if rc == 0:
            detail = T["apt_update_ok" if run_update else "apt_update_skipped"]
            self.info(T["apt_written"], detail)
        elif rc == 3:
            self.info(T["apt_written"], T["apt_update_failed"].format(log=tail))
        else:
            self.info(T["write_failed"], T["apt_write_failed_detail"])
        return False

    def selected_mode(self):
        if self.radio_external.get_active():
            return MODE_EXTERNAL
        if self.radio_internal.get_active():
            return MODE_INTERNAL
        return MODE_DEFAULT

    def load_state(self):
        try:
            self._config = read_config()
        except OSError as e:
            self.status.set_text(
                T["read_error"].format(path=CONFIG_PATH, err=e)
            )
            self.set_sensitive(False)
            return
        current = current_antenna(self._config)
        radio = {
            MODE_EXTERNAL: self.radio_external,
            MODE_INTERNAL: self.radio_internal,
            MODE_DEFAULT: self.radio_default,
        }[current]
        radio.set_active(True)
        state = {
            MODE_EXTERNAL: T["state_external"],
            MODE_INTERNAL: T["state_internal"],
            MODE_DEFAULT: T["state_default"],
        }[current]
        self.status.set_markup(
            T["status"].format(state=state, path=CONFIG_PATH)
        )

    def info(self, text, secondary=None):
        dlg = Gtk.MessageDialog(
            transient_for=self,
            message_type=Gtk.MessageType.INFO,
            buttons=Gtk.ButtonsType.OK,
            text=text,
        )
        if secondary:
            dlg.format_secondary_text(secondary)
        dlg.run()
        dlg.destroy()

    def on_apply(self, _btn):
        old = read_config()
        new = build_new_config(old, self.selected_mode())
        if new == old:
            self.info(T["no_change"], T["no_change_detail"])
            return

        dlg = DiffDialog(self, old, new)
        response = dlg.run()
        dlg.destroy()
        if response != Gtk.ResponseType.OK:
            return

        if write_config(new):
            self._config = new
            self.load_state()
            self.ask_reboot()
        else:
            self.info(T["write_failed"], T["write_failed_detail"])

    def ask_reboot(self):
        dlg = Gtk.MessageDialog(
            transient_for=self,
            message_type=Gtk.MessageType.QUESTION,
            text=T["written"],
        )
        dlg.format_secondary_text(T["written_detail"])
        dlg.add_button(T["reboot_later"], Gtk.ResponseType.CANCEL)
        dlg.add_button(T["reboot_now"], Gtk.ResponseType.OK)
        response = dlg.run()
        dlg.destroy()
        if response == Gtk.ResponseType.OK:
            subprocess.run(["pkexec", "reboot"], check=False)


def main():
    win = ToolboxWindow()
    win.connect("destroy", Gtk.main_quit)
    win.show_all()
    Gtk.main()


if __name__ == "__main__":
    sys.exit(main())
