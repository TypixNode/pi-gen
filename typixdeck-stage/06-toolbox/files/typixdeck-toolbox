#!/usr/bin/env python3
"""TypixDeck toolbox: a small GTK settings app for hardware options
that live in /boot/firmware/config.txt.

Currently manages the Wi-Fi/BT antenna selection of the CM modules:
  * external - dtparam=ant2, the U.FL connector on the compute module
  * internal - dtparam=ant1, the PCB antenna on the compute module
  * default  - no dtparam=ant* at all: the module's own default (CM4/CM5
               default to the PCB antenna, a CM0 has no PCB antenna and
               defaults to the external connector)

Apply never writes silently: it first shows a colored unified diff of
config.txt (old vs new) and only writes after explicit confirmation.
Semantics over bookkeeping: an existing commented-out line is uncommented
in place (keeping its position and section scope) rather than a new line
being appended; disabling comments lines out rather than deleting them.
Writing is done through pkexec, so the app itself runs unprivileged.

UI language follows the system locale (zh* -> Chinese, otherwise English).
"""

import difflib
import os
import subprocess
import sys
import tempfile

import gi

gi.require_version("Gtk", "3.0")
from gi.repository import Gtk, Pango  # noqa: E402

CONFIG_PATH = "/boot/firmware/config.txt"
MARK_BEGIN = "# --- TypixDeck toolbox ---"
MARK_END = "# --- end TypixDeck toolbox ---"
DISABLED_SUFFIX = "  # disabled by TypixDeck toolbox"

ANT_PARAMS = ("ant1", "ant2")
MODE_DEFAULT, MODE_INTERNAL, MODE_EXTERNAL = "default", "ant1", "ant2"

BLOCK_COMMENT = {
    "ant1": "# Wi-Fi/BT: force the PCB antenna on the compute module",
    "ant2": "# Wi-Fi/BT: external antenna on the compute module U.FL connector",
}

STRINGS = {
